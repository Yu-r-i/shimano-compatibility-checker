# デプロイ先ドメインが決まったら .env にコピーして値を上書きしてください。
# .env は .gitignore 対象です。

# index.html の canonical / og:url / JSON-LD url に使われるサイトの絶対URL（末尾スラッシュ推奨）
VITE_SITE_URL=https://example.workers.dev/

# OGP/Twitterカード用の画像の絶対URL
VITE_OGP_IMAGE_URL=https://example.workers.dev/ogp.png

# Google Search Console のサイト所有権確認トークン（未取得なら空のままでよい）
VITE_GOOGLE_SITE_VERIFICATION=
